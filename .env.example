# Copied into the WASM at build time (build.rs). Everything here is PUBLIC in the browser:
# restrict your RPC key to your site's origin in the provider dashboard.

# Full Sepolia RPC URL (Alchemy / Infura). Falls back to publicnode if unset.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Mainnet RPC used for ENS names. Falls back to publicnode if unset.
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Free project id from https://cloud.reown.com (needed for WalletConnect).
WALLETCONNECT_PROJECT_ID=
